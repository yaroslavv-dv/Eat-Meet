{
  "expo": {
    "name": "Eat&Meet",
    "slug": "eat-and-meet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eatmeet",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.eatmeet.demo"
    },
    "android": {
      "package": "app.eatmeet.demo",
      "adaptiveIcon": {
        "backgroundColor": "#1F5E45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eat&Meet uses your photo library so hosts can add a photo of their meal and dinner table."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
